# Neon (or any Postgres) connection string — no Docker
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/fc_karben?sslmode=verify-full
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Site URL — optional. On Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are used automatically.
# Only set locally (or to force a canonical host):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1&1 SFTP media webspace — required on Vercel; optional locally (falls back to ./media)
# SFTP_HOST=home….1and1-data.host
# SFTP_PORT=22
# SFTP_USER=
# SFTP_PASSWORD=
# SFTP_BASE_PATH=/wp-content/uploads
# MEDIA_PUBLIC_BASE_URL=https://fc-karben.de/wp-content/uploads

# Google Search Console HTML verification content (optional)
# NEXT_PUBLIC_GSC_VERIFICATION=

# Sentry (optional — enables error reporting; importMap always includes the admin boundary)
# SENTRY_DSN=

# Email via Resend (optional — recommended on Vercel; silences the "No email adapter" warning)
# Free tier at resend.com; verify a domain or use onboarding@resend.dev for tests
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=noreply@fc-karben.de
# EMAIL_FROM_NAME=FC Karben

# Draft Preview / Live Preview — required for admin Preview button & iframe
# PREVIEW_SECRET=long-random-string

# Soft-launch: leave unset/false so robots.txt disallows all + meta noindex/nofollow.
# Set to true only at cutover when Google should index the site.
# ALLOW_SEARCH_INDEXING=true

# Vercel Cron — protect /api/cron/sync-matches (MatchFeed ← fussball.de).
# On Vercel: Project Settings → Environment Variables → CRON_SECRET (auto-used as Bearer).
# Generate: openssl rand -hex 32
# CRON_SECRET=

# Instagram SocialFeed (Feedframer) — optional until the IG admin connects the club account.
# Free tier: https://feedframer.com — connect @fckarben Business/Creator, copy API key.
# Without this key the homepage Social Grid falls back to CMS „Social Tiles“.
# FEEDFRAMER_API_KEY=
# Optional public profile link (default https://www.instagram.com/fckarben/)
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fckarben/

# Payload MCP HTTP tools (optional — keep off in prod unless you need AI CMS access)
# ENABLE_PAYLOAD_MCP=true
