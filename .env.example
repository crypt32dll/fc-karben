# Neon (or any Postgres) connection string — no Docker
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/fc_karben?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 — production image/file storage (not Vercel Blob)
# Without these, Payload stores uploads locally in ./media (dev only)
# R2_BUCKET=fc-karben-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# NEXT_PUBLIC_MEDIA_URL=https://media.fc-karben.de

# Google Search Console HTML verification content (optional)
# NEXT_PUBLIC_GSC_VERIFICATION=
